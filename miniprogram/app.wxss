/**
 * SmoothGo mini program -- the web demo's design language, sized for a phone.
 *
 * The palette, the type pairing and the rules are web/styles.css, which is
 * what the deck screenshots and the GitHub preview show. A green card here
 * would make the two products look like different projects.
 *
 * What had to change for the smaller canvas:
 *   - Sizes are in rpx, not px. The web app sets labels at 7-9px, which is
 *     legible on a 1440px desktop and invisible on a 375px phone. The ratios
 *     are kept (label ~0.4 of the section heading) but the floor is 20rpx.
 *   - Two column desktop grids -- the hero, the signal strip, the queue list --
 *     collapse to one column, or to 2x2 where four numbers belong together.
 *   - `:root` becomes `page`, and `font-family` is inherited the same way.
 */

page {
  --ink: #111111;
  --ink-soft: #3a3a3a;
  --muted: #6c6c6c;
  --line: #d8d8d8;
  --line-dark: #a8a8a8;
  --paper: #ffffff;
  --soft: #f5f5f5;
  --app-bg: #ededed;
  --serif: "Songti SC", "Noto Serif SC", "STSong", Georgia, serif;
  --sans: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", Arial, sans-serif;

  background: var(--app-bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 26rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, input, textarea, button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* ---------- shell ---------- */

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.sheet {
  background: var(--paper);
  border-top: 1rpx solid var(--line);
}

/* ---------- type ---------- */

.kicker {
  display: flex;
  align-items: center;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

/* The 23px rule in front of every kicker on the web build. Without it these
   read as ordinary grey text rather than as section eyebrows. */
.kicker::before {
  content: "";
  display: inline-block;
  width: 46rpx;
  height: 2rpx;
  margin-right: 14rpx;
  background: var(--ink);
}

.serif {
  font-family: var(--serif);
  font-weight: 400;
}

.h1 {
  margin: 20rpx 0 0;
  font-family: var(--serif);
  font-size: 68rpx;
  font-weight: 400;
  line-height: 0.98;
  letter-spacing: -2rpx;
}

.h1 em {
  font-style: normal;
  text-decoration: underline;
  text-decoration-thickness: 2rpx;
  text-underline-offset: 12rpx;
}

.h2 {
  margin: 8rpx 0 0;
  font-family: var(--serif);
  font-size: 44rpx;
  font-weight: 400;
  letter-spacing: -1rpx;
}

.lede {
  margin: 14rpx 0 0;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.muted {
  color: var(--muted);
}

.tiny {
  font-size: 22rpx;
}

.micro {
  font-size: 20rpx;
}

.tracked {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ---------- structure ---------- */

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 28rpx 14rpx;
  border-bottom: 1rpx solid var(--ink);
}

.section-head .section-actions {
  flex: none;
}

.pad {
  padding: 0 28rpx;
}

.rule {
  height: 1rpx;
  background: var(--line);
}

/* ---------- controls ---------- */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--ink);
  background: var(--paper);
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1;
}

.btn.dark {
  background: var(--ink);
  color: var(--paper);
}

.btn.outline {
  background: var(--paper);
  color: var(--ink);
}

.btn.block {
  width: 100%;
  min-height: 76rpx;
}

.text-link {
  display: inline-block;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid var(--ink);
  background: transparent;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.chip {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1;
}

.chip.on {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

/* ---------- form ---------- */

.card {
  background: var(--paper);
  border: 1rpx solid var(--ink);
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.field > text {
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.field input,
.field .value {
  min-height: 60rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-size: 24rpx;
  line-height: 60rpx;
}

.field .value {
  color: var(--ink);
}

.input-line {
  min-height: 76rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--line-dark);
  background: var(--soft);
  color: var(--ink);
  font-size: 24rpx;
}

/* ---------- notice ---------- */

.notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 28rpx;
  padding: 20rpx 24rpx;
  border-left: 4rpx solid var(--ink);
  background: var(--soft);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.7;
}

/* ---------- empty ---------- */

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty .empty-title {
  font-family: var(--serif);
  font-size: 36rpx;
}

.empty .empty-body {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.7;
}
