<view class="page">

  <view class="route-head">
    <view class="kicker">{{kicker}}</view>
    <view class="h2">{{title}}</view>
    <view class="micro muted">{{subtitle}}</view>

    <view class="summary">
      <view class="summary-cell" wx:for="{{summary}}" wx:key="key">
        <text class="serif summary-value">{{item.value}}</text>
        <text class="micro muted">{{item.label}}</text>
      </view>
    </view>

    <view class="head-actions">
      <view class="btn" bindtap="onNavigate">{{navLabel}}</view>
      <view class="btn dark" bindtap="onReplan">{{replanLabel}}</view>
      <view class="btn" bindtap="onAddPlace">{{addLabel}}</view>
    </view>
  </view>

  <!-- Day tabs only appear for a multi-day plan; the web build hides them too. -->
  <scroll-view wx:if="{{showDays}}" class="day-tabs" scroll-x enable-flex>
    <view
      wx:for="{{days}}"
      wx:key="index"
      class="day-tab {{item.active ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="onDay"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{banner}}" class="banner">{{banner}}</view>

  <view class="pad">
    <view class="map-card">
      <map
        wx:if="{{hasRoute}}"
        class="route-map"
        latitude="{{latitude}}"
        longitude="{{longitude}}"
        scale="{{scale}}"
        markers="{{markers}}"
        polyline="{{polyline}}"
      ></map>
      <view wx:else class="route-map route-map-empty">
        <text class="micro muted">{{mapEmptyLabel}}</text>
      </view>
    </view>

    <view class="sheet">
      <view class="sheet-head">
        <text class="serif">{{sheetTitle}}</text>
        <text class="micro muted">{{sheetNote}}</text>
      </view>

      <block wx:if="{{hasPlan}}">
        <view class="stop" wx:for="{{stops}}" wx:key="id">
          <view class="stop-time">{{item.arrival}}</view>

          <view class="stop-body">
            <view class="stop-top">
              <text class="serif stop-name">{{item.name}}</text>
              <text wx:if="{{item.badge}}" class="tag">{{item.badge}}</text>
            </view>
            <text class="micro muted stop-type">{{item.type}}</text>
            <text class="micro muted stop-metrics">{{item.rating}} · {{item.avgLabel}} · {{item.hours}}</text>

            <view class="stop-queue">
              <text class="micro">{{queueLabel}} {{item.queueRange}}′</text>
              <text class="micro muted">{{item.queueBasis}}</text>
            </view>
            <text wx:if="{{item.reason}}" class="micro stop-reason">{{item.reason}}</text>

            <view class="stop-actions">
              <view class="text-link" bindtap="onNavigate">{{navLabel}}</view>
              <view class="text-link stop-remove" data-id="{{item.id}}" bindtap="onRemove">{{removeLabel}}</view>
            </view>
          </view>

          <view class="stop-queue-side">
            <text class="serif">{{item.queueRange}}</text>
            <text class="micro muted">{{minuteLabel}}</text>
          </view>
        </view>
      </block>

      <view wx:else class="notice">{{emptyBody}}</view>
    </view>
  </view>

  <view class="notice">{{footnote}}</view>
</view>
