/* Route. Mirrors .route-page-head, .route-summary, .day-tabs, .map-card and
   .route-sheet from the web build. The web layout is map-left / sheet-right;
   on a phone it stacks, map first, because a 200px-tall map beside a list
   leaves room for neither. */

.route-head {
  padding: 32rpx 28rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}

.summary {
  display: flex;
  gap: 34rpx;
  margin-top: 24rpx;
}

.summary-cell {
  min-width: 96rpx;
}

.summary-value {
  display: block;
  font-size: 40rpx;
  line-height: 1.2;
}

.summary-cell .micro {
  display: block;
  margin-top: 6rpx;
}

.head-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

/* ---------- day tabs ---------- */

.day-tabs {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 28rpx 4rpx;
  background: var(--paper);
}

.day-tab {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 22rpx;
}

.day-tab.on {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

.banner {
  padding: 18rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--soft);
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.6;
}

/* ---------- map ---------- */

.map-card {
  overflow: hidden;
  margin-top: 24rpx;
  border: 1rpx solid var(--line-dark);
  background: #f2f2f2;
}

.route-map {
  width: 100%;
  height: 420rpx;
}

.route-map-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- sheet ---------- */

.sheet {
  border: 1rpx solid var(--line-dark);
  border-top: 0;
  background: var(--paper);
}

.sheet-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.sheet-head .serif {
  font-size: 36rpx;
}

.stop {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.stop-time {
  flex: none;
  width: 92rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.stop-body {
  flex: 1;
  min-width: 0;
}

.stop-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.stop-name {
  font-size: 32rpx;
  line-height: 1.3;
}

.tag {
  flex: none;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--line-dark);
  color: var(--muted);
  font-size: 18rpx;
}

.stop-type,
.stop-metrics {
  display: block;
  margin-top: 6rpx;
}

.stop-queue {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  background: var(--soft);
}

.stop-queue .micro {
  display: block;
  line-height: 1.6;
}

.stop-reason {
  display: block;
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-style: italic;
}

.stop-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 14rpx;
}

.stop-remove {
  border-bottom-color: var(--line-dark);
  color: var(--muted);
}

.stop-queue-side {
  flex: none;
  width: 88rpx;
  text-align: right;
}

.stop-queue-side .serif {
  font-size: 34rpx;
}
