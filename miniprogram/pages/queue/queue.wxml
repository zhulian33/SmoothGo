<view class="page">
  <view class="head">
    <view>
      <view class="head-title">{{title}}</view>
      <view class="muted">{{stamp}} · {{sourceNote}}</view>
    </view>
    <view class="refresh" bindtap="onRefresh">{{refreshLabel}}</view>
  </view>

  <view class="card queue-card" wx:for="{{items}}" wx:key="id">
    <view class="q-top">
      <view class="q-left">
        <view class="q-name">{{item.name}}</view>
        <view class="muted">{{item.type}}</view>
      </view>
      <view class="q-right">
        <view class="q-wait">{{item.range}}<text class="unit">′</text></view>
        <view class="q-arrival muted">{{item.arrival}}</view>
      </view>
    </view>
    <view class="q-basis">
      <text class="tag">{{tagLabel}}</text>
      <text>{{item.basis}}</text>
    </view>
  </view>

  <view class="footnote">{{footnote}}</view>
</view>
