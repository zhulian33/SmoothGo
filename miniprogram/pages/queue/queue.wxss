/* Queue. Mirrors .view-head and .queue-card from the web build. The web
   queue-list is a three-column grid; on a phone it is one card per row, with
   the range and its basis side by side inside the card. */

.view-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 32rpx 28rpx 22rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}

.view-head-text {
  flex: 1;
  min-width: 0;
}

.view-head .lede {
  max-width: 520rpx;
}

.head-btn {
  flex: none;
}

.queue-card {
  padding: 26rpx 24rpx;
  border: 1rpx solid var(--line);
  border-top: 0;
  background: var(--paper);
}

.queue-card:first-of-type {
  border-top: 1rpx solid var(--line);
}

.queue-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.queue-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  line-height: 1.3;
}

.queue-card .micro {
  display: block;
  margin-top: 6rpx;
}

.queue-body {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.queue-range {
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.queue-value {
  font-size: 46rpx;
  line-height: 1.1;
}

.queue-unit {
  flex: none;
}

.queue-meta {
  flex: 1;
  min-width: 0;
}

.queue-meta .micro {
  line-height: 1.6;
}

.queue-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.btn.small {
  min-height: 52rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.notice-mark {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin-top: 12rpx;
  background: var(--ink);
}

.notice-text {
  flex: 1;
  min-width: 0;
}

.footnote {
  padding: 0 28rpx 40rpx;
  text-align: center;
}
