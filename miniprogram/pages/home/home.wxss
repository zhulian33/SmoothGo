/* Home. Everything here mirrors .home-hero, .planner-card, .signal-strip and
   .section-head from web/styles.css, with the grids collapsed for a phone. */

/* ---------- top bar ---------- */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}

.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* The web build's wordmark is a circle with a serif S inside it. */
.brand-mark {
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid var(--ink);
  border-radius: 50%;
  font-family: var(--serif);
  font-size: 34rpx;
  line-height: 52rpx;
  text-align: center;
}

.brand-type {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.brand-name {
  font-family: var(--serif);
  font-size: 32rpx;
  letter-spacing: -1rpx;
}

.brand-sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.city-button {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.city-dot {
  width: 10rpx;
  height: 10rpx;
  border: 1rpx solid var(--ink);
  border-radius: 50%;
}

.lang-button {
  color: var(--muted);
  font-size: 22rpx;
}

/* ---------- hero ---------- */

.hero {
  padding: 40rpx 28rpx 34rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}

/* The web build puts a <br> between the two halves of the title. Two inline
   <text> nodes have no such break, so "Any season is a good season" ran
   straight into "It is Changchun." */
.h1 text {
  display: block;
}

.h1-em {
  font-style: normal;
  text-decoration: underline;
  text-underline-offset: 12rpx;
  text-decoration-thickness: 2rpx;
}

/* ---------- planner card ---------- */

.planner-card {
  margin-top: 36rpx;
  padding: 24rpx;
  border: 1rpx solid var(--ink);
}

.planner-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.planner-title {
  font-size: 34rpx;
}

.nlp-row {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  margin-top: 18rpx;
}

.nlp-input {
  flex: 1;
  min-height: 76rpx;
  padding: 16rpx;
  line-height: 1.6;
}

.nlp-btn {
  flex: none;
  min-height: 76rpx;
  padding: 0 24rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr 0.82fr 0.72fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.caret {
  color: var(--muted);
  font-size: 20rpx;
}

.planner-foot {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
}

.planner-foot .micro {
  flex: 1;
}

.ph {
  color: var(--line-dark);
}

/* ---------- map preview ---------- */

.map-card {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  border: 1rpx solid var(--line-dark);
  background: #f2f2f2;
}

.map-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}

.map-label {
  font-size: 22rpx;
  font-weight: 600;
}

.map-live {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.live-dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--ink);
  border-radius: 50%;
}

.home-map {
  width: 100%;
  height: 380rpx;
}

.home-map-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f2f2;
}

.preview-card {
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--ink);
  border-top: 0;
}

.preview-title {
  display: block;
  font-size: 34rpx;
}

.preview-summary {
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

.preview-card .text-link {
  margin-top: 14rpx;
}

/* ---------- signal strip ---------- */

.signal-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}

.signal-item {
  padding: 28rpx;
  border-top: 1rpx solid var(--line);
}

.signal-item:nth-child(2n) {
  border-left: 1rpx solid var(--line);
}

.signal-value {
  display: block;
  margin-top: 10rpx;
  font-size: 40rpx;
}

.signal-item .micro {
  display: block;
  margin-top: 8rpx;
}

/* ---------- today ---------- */

.today-row {
  display: flex;
  white-space: nowrap;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}

.today-card {
  display: inline-block;
  width: 240rpx;
  padding: 22rpx;
  margin-right: 16rpx;
  border: 1rpx solid var(--line);
  vertical-align: top;
  white-space: normal;
}

.today-index {
  font-family: var(--serif);
  font-size: 28rpx;
  color: var(--muted);
}

.today-name {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.3;
}

.today-card .micro {
  display: block;
}

.today-arrival {
  margin-top: 10rpx;
  font-weight: 600;
}
