<view class="page">

  <view class="view-head">
    <view class="kicker">{{kicker}}</view>
    <view class="h2">{{title}}</view>
    <view class="lede">{{subtitle}}</view>
    <view class="micro muted data-note">{{dataNote}}</view>
  </view>

  <view class="toolbar">
    <view class="toolbar-search">
      <input
        class="search-input"
        value="{{searchValue}}"
        placeholder="{{searchPlaceholder}}"
        placeholder-class="search-placeholder"
        bindinput="onSearch"
      />
      <view wx:if="{{searchValue}}" class="search-clear" bindtap="onClearSearch">×</view>
    </view>

    <view class="filter-wrap">
      <scroll-view class="filter-chips" scroll-x>
        <view
          wx:for="{{filters}}"
          wx:key="key"
          class="chip {{item.key === activeFilter ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFilter"
        >{{item.label}}</view>
      </scroll-view>
      <view class="filter-fade"></view>
    </view>
  </view>

  <!-- The layer switcher and the base-map toggles sit on the map's own top
       edge, so they read as map controls rather than as two more form rows. -->
  <view class="map-card">
    <view class="map-bar">
      <view
        wx:for="{{layers}}"
        wx:key="key"
        class="layer-tab {{item.key === activeLayer ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onMode"
      >{{item.label}}<text class="layer-count">{{item.count}}</text></view>

    </view>

    <map
      wx:if="{{hasPoints}}"
      id="placeMap"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      polyline="{{polyline}}"
      include-points="{{points}}"
      enable-satellite="{{satellite}}"
      enable-traffic="{{traffic}}"
      bindmarkertap="onMarkerTap"
      show-location="{{false}}"
    ></map>
    <view wx:else class="map-empty">
      <text class="micro muted">{{emptyLabel}}</text>
    </view>

    <view class="map-foot">
      <text class="micro muted map-credit">{{footnote}}</text>
      <view class="mode-row">
        <view class="chip small {{satellite ? 'on' : ''}}" bindtap="onSatellite">{{satelliteLabel}}</view>
        <view class="chip small {{traffic ? 'on' : ''}}" bindtap="onTraffic">{{trafficLabel}}</view>
      </view>
    </view>
  </view>

  <block wx:if="{{selected}}">
    <view class="pad">
      <view class="card detail">
        <view class="detail-head">
          <text class="serif detail-name">{{selected.name}}</text>
        </view>
        <text class="micro muted">{{selected.type}} · {{selected.subtitle}} · {{selected.distance}}</text>
        <text class="micro muted">{{selected.rating}} · {{selected.avg}} · {{selected.hours}}</text>

        <view class="detail-queue">
          <text class="serif detail-wait">{{selected.wait}}</text>
          <text class="micro muted detail-unit">{{labels.minute}}</text>
          <text class="micro muted detail-basis">{{labels.wait}} · {{selected.basis}}</text>
        </view>

        <!-- The qualifier used to sit beside the name and squeezed it onto two
             lines; here it reads as a footnote to the estimate it qualifies. -->
        <text class="micro muted detail-note">{{selected.modelled}}</text>

        <view class="detail-actions">
          <view class="btn {{selected.inRoute ? 'dark' : ''}}" data-id="{{selected.id}}" bindtap="onAdd">{{selected.addLabel}}</view>
          <view class="btn" data-id="{{selected.id}}" bindtap="onNavigate">{{labels.nav}}</view>
        </view>
      </view>
    </view>
  </block>

  <view class="section-head">
    <view class="serif section-title">{{listTitle}}</view>
    <text class="micro muted">{{countLabel}}</text>
  </view>

  <view class="place-list">
    <block wx:if="{{hasPlaces}}">
      <view
        wx:for="{{places}}"
        wx:key="id"
        class="place-card {{item.selected ? 'selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectPlace"
      >
        <view class="place-head">
          <text class="serif place-name">{{item.name}}</text>
        </view>
        <view class="place-meta">
          <text wx:if="{{item.badge}}" class="tag">{{item.badge}}</text>
          <text class="micro muted">{{item.type}}</text>
        </view>
        <text class="micro muted">{{item.subtitle}} · {{item.distance}}</text>
        <text class="micro muted">{{item.rating}} · {{item.avg}} · {{item.hours}}</text>
        <text class="micro place-queue">{{labels.wait}} {{item.wait}} {{labels.minute}} · {{item.basis}}</text>

        <view class="place-actions">
          <view class="btn small {{item.inRoute ? 'dark' : ''}}" data-id="{{item.id}}" catchtap="onAdd">{{item.addLabel}}</view>
          <view class="btn small" data-id="{{item.id}}" catchtap="onNavigate">{{labels.nav}}</view>
        </view>
      </view>
    </block>

    <view wx:else class="empty">
      <view class="empty-body">{{emptyLabel}}</view>
    </view>
  </view>

</view>
