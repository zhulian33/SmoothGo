/* Map. Mirrors #view-map in the web build: head, search, filter chips, layer
   bar, map, place list.

   Three decisions keep this page from feeling like a form:

   1. Two bands, not four. The layer switcher and the satellite/traffic
      toggles live on the map's own top edge, so they read as map controls.
   2. Only one band is built from boxes. Filters are outlined chips; layers
      are underlined text tabs with their counts, the same split the web
      build uses.
   3. Nothing is set at the web build's 9px. On a 375pt phone that is 11px and
      half a fingertip, which is what made the page feel packed -- so type
      goes up one step here and the tap targets go with it. */

.micro {
  font-size: 21rpx;
}

.view-head {
  padding: 30rpx 28rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}

.view-head .lede {
  max-width: 620rpx;
  font-size: 26rpx;
}

.view-head .data-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
}

/* ---------- search + filters ---------- */

.toolbar {
  background: var(--paper);
  border-top: 1rpx solid var(--line);
}

.toolbar-search {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin: 26rpx 28rpx 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--line-dark);
  background: var(--paper);
}

.search-input {
  flex: 1;
  min-height: 76rpx;
  font-size: 26rpx;
}

.search-placeholder {
  color: var(--muted);
}

.search-clear {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  margin-left: 12rpx;
  color: var(--muted);
  font-size: 34rpx;
  line-height: 48rpx;
  text-align: center;
}

.filter-wrap {
  position: relative;
  margin-top: 20rpx;
}

.filter-chips {
  white-space: nowrap;
  padding: 0 0 20rpx 28rpx;
}

/* The row scrolls, and a chip cut off by the screen edge reads as a bug
   rather than as "there is more". A short fade makes the cut deliberate. */
.filter-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 20rpx;
  width: 44rpx;
  background: linear-gradient(to right, rgba(255, 255, 255, 0), #ffffff 85%);
  pointer-events: none;
}

.filter-chips .chip {
  min-height: 60rpx;
  margin-right: 16rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  vertical-align: top;
}

/* Trailing clearance so the last chip is not sliced by the screen edge. */
.filter-chips .chip:last-child {
  margin-right: 28rpx;
}

/* ---------- map ---------- */

.map-card {
  overflow: hidden;
  margin-top: 26rpx;
  border-top: 1rpx solid var(--line-dark);
  border-bottom: 1rpx solid var(--line-dark);
  background: var(--paper);
}

.map-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 18rpx 22rpx 14rpx;
  border-bottom: 1rpx solid var(--line);
}

.layer-tab {
  display: inline-flex;
  align-items: baseline;
  margin-right: 24rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid transparent;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.layer-tab.on {
  border-bottom-color: var(--ink);
  color: var(--ink);
}

.layer-count {
  margin-left: 8rpx;
  font-size: 21rpx;
  font-weight: 400;
  opacity: 0.6;
}

.mode-row {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.mode-row .chip.small {
  min-height: 46rpx;
  margin-left: 8rpx;
  padding: 0 14rpx;
  font-size: 20rpx;
}

.map {
  width: 100%;
  height: 480rpx;
  background: #f2f2f2;
}

.map-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 320rpx;
}

/* Base-map switches and the coordinate note, where a map's attribution goes
   rather than in a fourth row of controls above the map. */
.map-foot {
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx 14rpx;
  border-top: 1rpx solid var(--line);
}

.map-credit {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 20rpx;
}

/* ---------- selected card ---------- */

.tag {
  flex: none;
  padding: 3rpx 12rpx;
  border: 1rpx solid var(--line-dark);
  color: var(--muted);
  font-size: 19rpx;
}

.detail {
  margin-top: 26rpx;
  padding: 28rpx;
}

.detail-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.detail-name {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  font-size: 38rpx;
  line-height: 1.3;
}

.detail .micro {
  display: block;
  margin-top: 8rpx;
}

.detail-queue {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding: 18rpx;
  background: var(--soft);
}

.detail-wait {
  margin-right: 10rpx;
  font-size: 46rpx;
  line-height: 1.1;
}

.detail-unit {
  flex: none;
}

.detail-basis {
  width: 100%;
  margin-top: 6rpx;
}

.detail-note {
  display: block;
  margin-top: 10rpx;
}

.detail-actions {
  display: flex;
  margin-top: 24rpx;
}

.detail-actions .btn {
  flex: 1;
  margin-right: 14rpx;
  min-height: 72rpx;
}

.detail-actions .btn:last-child {
  margin-right: 0;
}

/* ---------- list ---------- */

.section-head {
  padding: 34rpx 28rpx 18rpx;
}

.section-title {
  font-size: 36rpx;
}

.place-list {
  background: var(--paper);
}

.place-card {
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.place-card:last-child {
  border-bottom: 0;
}

.place-card.selected {
  border-left: 6rpx solid var(--ink);
  padding-left: 22rpx;
  background: var(--soft);
}

.place-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.place-name {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  font-size: 34rpx;
  line-height: 1.3;
}

.place-card .micro {
  display: block;
  margin-top: 8rpx;
}

.place-queue {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  background: var(--soft);
}

.place-actions {
  display: flex;
  margin-top: 22rpx;
}

.place-actions .btn {
  margin-right: 14rpx;
}

.place-actions .btn:last-child {
  margin-right: 0;
}

.btn.small {
  min-height: 60rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}
