# Server
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=*

# Change this before any real deployment.
OTP_SECRET=replace-with-a-long-random-secret
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
SESSION_TTL_DAYS=30
QUEUE_MONTHLY_LIMIT=2

# mock | aliyun | aliyun_verify | webhook
SMS_PROVIDER=mock

# In mock mode, the API returns a devCode to the browser for local testing.
# Set to 0 for any real deployment.
DEV_SHOW_CODE=1

# Aliyun SMS (SMS_PROVIDER=aliyun)
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou

# Phone Number Verification Service (SMS_PROVIDER=aliyun_verify).
# Recommended for personal accounts: no enterprise qualification, no signature
# filing, no template review. Copy the granted SignName/TemplateCode from
# https://dypns.console.aliyun.com/smsCertParamsConfig/sign
ALIYUN_VERIFY_ACCESS_KEY_ID=
ALIYUN_VERIFY_ACCESS_KEY_SECRET=
ALIYUN_VERIFY_SIGN_NAME=
ALIYUN_VERIFY_TEMPLATE_CODE=100001
# Template variables. ##code## and ##min## are replaced at send time.
ALIYUN_VERIFY_TEMPLATE_PARAM={"code":"##code##","min":"##min##"}

# Generic gateway (SMS_PROVIDER=webhook)
# raw: your gateway receives JSON {"phone":"+8613800138000","code":"123456","template":"smoothgo_login"}
# pushplus: sends {token,title,content} to PushPlus and the code arrives as a
# WeChat message. Free tier is 200 messages/day, get a token at https://www.pushplus.plus
SMS_WEBHOOK_FORMAT=raw
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_WEBHOOK_TEMPLATE=smoothgo_login

# Amap POI proxy (optional).
# Needs a "Web服务" type key from https://console.amap.com/dev/key/app
# The browser JS API key does NOT work here, and this key cannot render a map.
# Leave it empty if you only use the in-page AMap.PlaceSearch panel.
AMAP_WEB_SERVICE_KEY=
